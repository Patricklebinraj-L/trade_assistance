APP_NAME="BTC Intelligence"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/btc-intelligence-platform
APP_TIMEZONE=Asia/Kolkata
APP_AUTO_MIGRATE=true
DELTA_BASE_URL=https://api.india.delta.exchange
# Verify the exact product symbol in your Delta account before using calculations.
# Delta India derivatives commonly use BTCUSD; this is not necessarily BTC/USDT spot.
DELTA_SYMBOL=BTCUSD
DELTA_CANDLE_RESOLUTION=15m
DELTA_HTTP_TIMEOUT=8
DELTA_PRODUCT_LABEL="BTC contract - verify symbol"
DELTA_API_KEY=
DELTA_API_SECRET=
CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btc_intelligence
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DEFAULT_CAPITAL=2000
DEFAULT_RISK_PERCENT=0.5
MAX_RISK_PERCENT=1
MAX_DAILY_LOSS_PERCENT=2
